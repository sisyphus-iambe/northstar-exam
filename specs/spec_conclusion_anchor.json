    "ar1": {
      "kind": "generator_ar1",
      "params": {
        "eps_var": "eps ~ N(0, 1-rho^2), 乘 sqrt(1-rho^2) 使边际 N(0,1)",
        "note": "expD run_ar1.py 同码; rho/n/target 逐链声明在 chains[].dataset_params"
      }
    },
